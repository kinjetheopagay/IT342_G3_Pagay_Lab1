<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2D3E6B"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <!-- Date + Delete row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#7F77DD"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvShift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="DELETE"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E24B4A"
            android:paddingHorizontal="12dp"/>

    </LinearLayout>

    <!-- Supervisor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUPERVISOR"
        android:textSize="11sp"
        android:textColor="#9BA4C7"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvSupervisor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1D9E75"
        android:layout_marginBottom="12dp"/>

    <!-- Employees label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMPLOYEES"
        android:textSize="11sp"
        android:textColor="#9BA4C7"
        android:layout_marginBottom="8dp"/>

    <!-- Employee badges container -->
    <LinearLayout
        android:id="@+id/layoutEmployees"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>

</LinearLayout>