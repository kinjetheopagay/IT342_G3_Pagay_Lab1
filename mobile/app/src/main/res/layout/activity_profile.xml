<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2A4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back + Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="← Back"
                android:textSize="13sp"
                android:textColor="#7F77DD"
                android:backgroundTint="#1E2A4A"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Success message -->
        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Profile picture updated!"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="#1D9E75"
            android:padding="10dp"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:visibility="gone"/>

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2D3E6B"
            android:padding="24dp"
            android:layout_marginBottom="24dp">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:scaleType="centerCrop"
                    android:background="#4A3DB5"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvAvatarPlaceholder"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:text="👤"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:background="#4A3DB5"/>

                <Button
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="📷"
                    android:textSize="12sp"
                    android:backgroundTint="#E85D24"
                    android:padding="0dp"
                    android:layout_gravity="bottom|end"/>

            </FrameLayout>

            <!-- Name -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <!-- Role under name -->
            <TextView
                android:id="@+id/tvRoleSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="#7F77DD"
                android:layout_marginBottom="24dp"/>

            <!-- Employee ID -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMPLOYEE ID"
                android:textSize="12sp"
                android:textColor="#9BA4C7"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvEmployeeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textSize="12sp"
                android:textColor="#9BA4C7"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- Role -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROLE"
                android:textSize="12sp"
                android:textColor="#9BA4C7"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="LOGOUT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#E24B4A"/>

    </LinearLayout>
</ScrollView>