<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2A4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Card with logo inside -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#8B9FEF"
            android:padding="24dp"
            android:layout_marginTop="48dp">

            <!-- Logo inside card -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/staff_guard_logo"
                android:scaleType="fitCenter"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login to your StaffGuard account"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1E2A4A"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E2A4A"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter your email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:background="#C5CCF0"
                android:textColor="#1E2A4A"
                android:textColorHint="#9BA4C7"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSWORD"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#1E2A4A"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:background="#C5CCF0"
                android:textColor="#1E2A4A"
                android:textColorHint="#9BA4C7"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/loginBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="LOGIN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#1E2A4A"
                android:paddingHorizontal="40dp"
                android:layout_gravity="center"/>

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New User? Create an account"
            android:textColor="#7F77DD"
            android:textSize="13sp"
            android:padding="16dp"/>

    </LinearLayout>
</ScrollView>